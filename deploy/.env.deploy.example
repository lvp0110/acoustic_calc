# Для локального запуска можно указать SSH alias vkfront и оставить jump пустым.
DEPLOY_HOST=altair@prodfront.mcs.local
DEPLOY_JUMP_HOST=antares@gateway.example.com

DEPLOY_DIR=/home/altair/work/acoustic_calc

# Публичный домен, обслуживаемый gateway-01.
DEPLOY_DOMAIN=acousticcalc.constrtodo.ru

# Для приватного репозитория создайте read-only deploy key на prodfront и alias
# github-acoustic-calc в ~/.ssh/config.
REPO_URL=git@github-acoustic-calc:lvp0110/acoustic_calc.git

DEPLOY_REMOTE=origin
DEPLOY_REV=origin/main
