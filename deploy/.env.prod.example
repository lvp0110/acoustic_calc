# Приватный IP prodfront, доступный только gateway-01.
FRONTEND_BIND_IP=10.0.0.249
FRONTEND_HOST_PORT=3010

# Внутренний адрес основного ConstrTodo backend. Браузер обращается к /api,
# а frontend-контейнер проксирует запросы внутри локальной сети.
BASE_URL=http://prodbackend.mcs.local:3005
REQUEST_TIMEOUT_MS=1800000
